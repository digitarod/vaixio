# サーバー設定
PORT=3000
VAIXIO_HOST=0.0.0.0
# Traefik越しの場合、実ドメインを明示する（未設定時は 127.0.0.1/localhost のみ許可）
VAIXIO_ALLOWED_HOSTS=mcp.example.com

# auth-vault: customers/<name>/config.yaml の credentials / mcp_token を解決する
# vault://<customer>/<key>  ->  VAULT__<CUSTOMER>__<KEY>
VAULT__ADMIN__MCP_TOKEN=change-me

# instagramコネクタ: Meta Graph API(Instagram API with Instagram Login)に直接投稿する。
# 顧客はGraph APIトークンを扱わず、/oauth/instagram/start?customer=<name> をブラウザで
# 開いてログインするだけで連携が完了する(interfaces/oauth/instagram-connect.ts)。
# Facebook Developerでアプリを作成し、有効なOAuth Redirect URIsに
# {VAIXIO_PUBLIC_BASE_URL}/oauth/instagram/callback を登録すること。
INSTAGRAM_APP_ID=change-me
INSTAGRAM_APP_SECRET=change-me
VAIXIO_PUBLIC_BASE_URL=https://mcp.example.com
# state改ざん防止用の署名鍵。openssl rand -hex 32 などで生成する（Instagram連携・
# ダッシュボードのGoogleログイン両方で共用する）
OAUTH_STATE_SECRET=change-me

# core/auth-vault/token-store.ts が OAuth で取得したアクセストークンを暗号化保存する鍵。
# openssl rand -base64 32 で生成した32byteの鍵(base64)を設定する。
VAULT_ENCRYPTION_KEY=change-me

# 顧客セルフサービスダッシュボード用DB(core/db/*)。docker-composeのpostgresサービスに合わせた値。
# 顧客ごとの秘密ではないインフラ設定なのでauth-vaultは経由しない。
DATABASE_URL=postgres://app:app@localhost:5432/app_db

# ダッシュボードのGoogleログイン(specs/dashboard-google-login.md)。
# Google Cloud ConsoleでOAuthクライアントID(種類: ウェブアプリケーション)を作成し、
# 承認済みのリダイレクトURIに {VAIXIO_PUBLIC_BASE_URL}/dashboard-api/auth/google/callback
# を登録すること。
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# google-business-profileコネクタ: Googleビジネスプロフィールの拠点情報・口コミ取得/返信。
# 顧客はBusiness Profile APIのトークンを扱わず、
# /oauth/google-business-profile/start?customer=<name> をブラウザで開いて
# Googleアカウントでログインするだけで連携が完了する
# (interfaces/oauth/google-business-profile-connect.ts)。
# ダッシュボードログイン用のGOOGLE_CLIENT_IDとはスコープの信頼領域が異なるため、
# Google Cloud Consoleで別のOAuthクライアント(種類: ウェブアプリケーション)を作成し、
# 承認済みのリダイレクトURIに
# {VAIXIO_PUBLIC_BASE_URL}/oauth/google-business-profile/callback を登録すること。
# 有効化が必要なAPI: My Business Account Management API / My Business Business
# Information API / My Business API(レビュー取得・返信、Googleへのアクセス申請が必要な場合あり)。
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=change-me
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=change-me

# facebook-pageコネクタ: Facebookページへのテキスト/画像投稿。
# 顧客はGraph APIトークンを扱わず、/oauth/facebook-page/start?customer=<name> をブラウザで
# 開いてFacebookログインするだけで連携が完了する(interfaces/oauth/facebook-page-connect.ts)。
# Meta for Developersでアプリを作成し(Instagramと同じアプリでも別アプリでも可)、
# 有効なOAuth Redirect URIsに {VAIXIO_PUBLIC_BASE_URL}/oauth/facebook-page/callback を
# 登録し、pages_show_list / pages_manage_posts / pages_read_engagement の権限を設定すること。
FACEBOOK_APP_ID=change-me
FACEBOOK_APP_SECRET=change-me
