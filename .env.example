# サーバー設定
PORT=3000
MUSUBI_HOST=0.0.0.0
# Traefik越しの場合、実ドメインを明示する（未設定時は 127.0.0.1/localhost のみ許可）
MUSUBI_ALLOWED_HOSTS=mcp.example.com

# auth-vault: customers/<name>/config.yaml の credentials / mcp_token を解決する
# vault://<customer>/<key>  ->  VAULT__<CUSTOMER>__<KEY>
VAULT__ADMIN__MCP_TOKEN=change-me

# instagramコネクタ(Zernio https://zernio.com 経由)。
# Zernioは1アカウントで複数クライアントのInstagramプロフィールを束ねる運用を想定し、
# APIキーは顧客ごとではなくコネクタ単位(vault://instagram/api_key)。対象アカウントは
# instagram.post.create 呼び出し時の account_id 引数で切り替える。
VAULT__INSTAGRAM__API_KEY=sk_change-me
